# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=aegisnet
POSTGRES_PASSWORD=aegisnet_secret
POSTGRES_DB=aegisnet

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Node backend ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://aegisnet:aegisnet_secret@localhost:5432/aegisnet
MQTT_BROKER_URL=mqtt://localhost:1883
AI_SERVICE_URL=http://localhost:8000

# ─── Python AI service ────────────────────────────────────────────────────────
AI_PORT=8000

# ─── Notifications (leave blank in dev — console mock is used) ────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
